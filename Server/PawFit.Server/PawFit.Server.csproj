<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Máy chủ riêng của PawFit (Phase 4): tài khoản khách, giờ máy chủ, lưu game, mã chuyển máy, rank, ghép trận + PvP.
    Dùng lại ĐÚNG code luật game trong Assets (Core / Pet / Battle / Online, C# thuần) — không copy:
    máy chủ chạy trận bằng cùng BattleSimulation với điện thoại.
        cd Server/PawFit.Server ; dotnet run
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PawFit.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/PawFit/Scripts/Core/**/*.cs" Exclude="../../Assets/PawFit/Scripts/Core/Unity/**" Link="Shared/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Assets/PawFit/Scripts/Pet/**/*.cs" Exclude="../../Assets/PawFit/Scripts/Pet/View/**" Link="Shared/Pet/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Assets/PawFit/Scripts/Battle/**/*.cs" Exclude="../../Assets/PawFit/Scripts/Battle/View/**" Link="Shared/Battle/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Assets/PawFit/Scripts/Online/**/*.cs" Link="Shared/Online/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
